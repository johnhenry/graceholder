{
  "name": "realism-distributions-spec: explicit distributions through the spec",
  "header": {
    "locale": "en",
    "keyScheme": "gh1"
  },
  "input": {
    "query": "{ samples(first: 6) { a b c d e } }",
    "options": {
      "seed": "realism"
    },
    "spec": {
      "samples.a": {
        "gen": {
          "name": "int",
          "args": {
            "min": 0,
            "max": 100,
            "dist": "normal"
          }
        }
      },
      "samples.b": {
        "gen": {
          "name": "float",
          "args": {
            "min": 0,
            "max": 1000,
            "dist": "lognormal"
          }
        }
      },
      "samples.c": {
        "gen": {
          "name": "int",
          "args": {
            "min": 1,
            "max": 500,
            "dist": "zipf",
            "s": 1.2
          }
        }
      },
      "samples.d": {
        "gen": {
          "name": "float",
          "args": {
            "min": 0,
            "max": 100,
            "dist": "powerlaw",
            "alpha": 1.5
          }
        }
      },
      "samples.e": {
        "gen": {
          "name": "money",
          "args": {
            "min": 5,
            "max": 500,
            "dist": "lognormal"
          }
        }
      }
    }
  },
