{
  "name": "directives-and-spec",
  "header": {
    "locale": "en",
    "keyScheme": "gh1"
  },
  "input": {
    "query": "query Dash($n: Int = 3) @seed(s: \"dash\") {\n  orders @count(min: 2, max: 4) {\n    code @pattern(p: \"ORD-#####\")\n    status @pick(values: [{value: \"new\", weight: 3}, {value: \"paid\", weight: 1}])\n    note @nullRate(p: 0.5)\n    items @count(n: $n) { name price quantity }\n    subtotal total\n  }\n  posts { title slug @derive(from: \"title\") author { id name } }\n  members { id name }\n}",
    "spec": {
      "posts.author": {
        "type": "User"
      },
      "members": {
        "type": "User",
        "count": 3
      },
      "@User.name": {
        "gen": "person.full"
      },
      "**.note": {
        "gen": "sentence"
      },
      "$options": {
        "poolSize": 5
      }
    },
    "options": {
      "seed": "spec"
    }
  },
