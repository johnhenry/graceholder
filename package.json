{
  "name": "@johnhenry/graceholder",
  "version": "0.1.0",
  "description": "Consistently repeatable generated data, in any shape you want, from a GraphQL query.",
  "keywords": [
    "graphql",
    "mock",
    "fake-data",
    "deterministic",
    "seeded",
    "testing"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./packs": {
      "types": "./src/packs/index.d.ts",
      "default": "./src/packs/index.js"
    },
    "./packs/commerce": {
      "types": "./src/packs/commerce.d.ts",
      "default": "./src/packs/commerce.js"
    },
    "./packs/finance": {
      "types": "./src/packs/finance.d.ts",
      "default": "./src/packs/finance.js"
    },
    "./packs/geo": {
      "types": "./src/packs/geo.d.ts",
      "default": "./src/packs/geo.js"
    },
    "./packs/health": {
      "types": "./src/packs/health.d.ts",
      "default": "./src/packs/health.js"
    },
    "./apollo": {
      "types": "./src/adapters/apollo.d.ts",
      "default": "./src/adapters/apollo.js"
    },
    "./urql": {
      "types": "./src/adapters/urql.d.ts",
      "default": "./src/adapters/urql.js"
    },
    "./fetch": {
      "types": "./src/adapters/fetch.d.ts",
      "default": "./src/adapters/fetch.js"
    },
    "./fast-check": {
      "types": "./src/fast-check.d.ts",
      "default": "./src/fast-check.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "STABILITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "node scripts/check-banned.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dts.json",
    "test": "node --test \"test/**/*.test.js\"",
    "test:golden": "node --test test/golden.test.js",
    "golden:update": "node scripts/update-golden.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:browser": "GRACEHOLDER_BROWSER=1 node --test test/browser.test.js test/playground.test.js",
    "stability": "node scripts/gen-stability.mjs",
    "docs:update": "node scripts/docs.mjs --write",
    "gen:types": "node scripts/gen-generator-types.mjs",
    "playground:build": "node scripts/build-playground.mjs",
    "playground:screenshot": "node scripts/playground-screenshot.mjs"
  },
  "author": "John Henry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.5",
    "@types/node": "^22.0.0",
    "@urql/core": "^6.0.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.64.1",
    "rxjs": "^7.8.2",
    "typescript": "^5.6.0",
    "wonka": "^6.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/graceholder.git"
  },
  "homepage": "https://github.com/johnhenry/graceholder#readme",
  "bugs": {
    "url": "https://github.com/johnhenry/graceholder/issues"
  },
  "peerDependencies": {
    "@apollo/client": ">=3.8.0 <5",
    "@urql/core": ">=5.0.0 <7",
    "fast-check": ">=3.0.0",
    "wonka": "^6.3.0"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@urql/core": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    },
    "wonka": {
      "optional": true
    }
  }
}
