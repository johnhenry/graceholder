{
  "name": "@johnhenry/graceholder",
  "version": "0.0.0",
  "private": true,
  "description": "Consistently repeatable generated data, in any shape you want, from a GraphQL query.",
  "keywords": [
    "graphql",
    "mock",
    "fake-data",
    "deterministic",
    "seeded",
    "testing"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./packs": {
      "types": "./src/packs/index.d.ts",
      "default": "./src/packs/index.js"
    },
    "./packs/commerce": {
      "types": "./src/packs/commerce.d.ts",
      "default": "./src/packs/commerce.js"
    },
    "./packs/finance": {
      "types": "./src/packs/finance.d.ts",
      "default": "./src/packs/finance.js"
    },
    "./packs/geo": {
      "types": "./src/packs/geo.d.ts",
      "default": "./src/packs/geo.js"
    },
    "./packs/health": {
      "types": "./src/packs/health.d.ts",
      "default": "./src/packs/health.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "STABILITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "node scripts/check-banned.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "test:golden": "node --test test/golden.test.js",
    "golden:update": "node scripts/update-golden.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:browser": "GRACEHOLDER_BROWSER=1 node --test test/browser.test.js",
    "stability": "node scripts/gen-stability.mjs",
    "docs:update": "node scripts/docs.mjs --write"
  },
  "author": "John Henry",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/graceholder.git"
  },
  "homepage": "https://github.com/johnhenry/graceholder#readme",
  "bugs": {
    "url": "https://github.com/johnhenry/graceholder/issues"
  }
}
